{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && exec node --enable-source-maps ./dist/index.mjs",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke:pdf": "node ./smoke/pdf.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@swc/helpers": "^0.5.23",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "docx": "^9.7.1",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "multer": "^2.0.2",
    "nodemailer": "^9.0.3",
    "openai": "^6.27.0",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.15.2",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "pptxgenjs": "^4.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^1.4.12",
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.13.9",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0",
    "vitest": "^4.1.10"
  }
}
