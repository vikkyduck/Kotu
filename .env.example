# ─────────────────────────────────────────────────────────────────────────────
# Kotu — образец конфигурации. Настоящий файл живёт на сервере в /opt/kotu/.env
# с правами 600 и НИКОГДА не попадает в git (см. .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

PORT=5010
DATABASE_URL=postgres://kotu:ПАРОЛЬ@localhost:5432/kotu

# Публичный адрес — от него зависит флаг secure у cookie сессии.
PUBLIC_BASE_URL=https://psy3107.ru

# ─── Адреса моделей ──────────────────────────────────────────────────────────
# ВАЖНО: все они указывают на внутренний маршрутизатор 127.0.0.1:8444.
# Приложение НИКОГДА не обращается к api.openai.com / api.anthropic.com и т.п.
# напрямую: из России эти адреса недоступны, а весь зарубежный трафик обязан
# идти через собственный транзит на дроплете DigitalOcean (206.189.181.64:8443),
# который принимает соединения только с этого сервера и ничего не сохраняет.
#
#   /v1/audio/*  → локальный Whisper (аудио вообще не покидает сервер в Москве)
#   /v1/*        → OpenAI
#   /anthropic/* → Claude
#   /gemini/*    → Gemini
#   /perplexity/*→ Perplexity
#
# Новый поставщик модели добавляется В ТРЁХ местах: маршрут в прокси на дроплете,
# location в /etc/nginx/sites-available/kotu-ai-router, переменная здесь.
AI_INTEGRATIONS_OPENAI_BASE_URL=http://127.0.0.1:8444/v1
ANTHROPIC_BASE_URL=http://127.0.0.1:8444/anthropic
GEMINI_BASE_URL=http://127.0.0.1:8444/gemini
PERPLEXITY_BASE_URL=http://127.0.0.1:8444/perplexity

# ─── Ключи ───────────────────────────────────────────────────────────────────
# Хранятся ТОЛЬКО на сервере в Москве. Через транзит проходят транзитом внутри
# заголовков запроса — на дроплете не сохраняются. Вводятся скриптами
# ./set-openai-key.sh и ./set-ai-key.sh вслепую.
AI_INTEGRATIONS_OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=...
PERPLEXITY_API_KEY=pplx-...

# Локальный распознаватель персональных данных (natasha).
NER_URL=http://127.0.0.1:9020/ner

# Куда складывать загруженное аудио (должно переживать перезапуск).
UPLOAD_DIR=/opt/kotu/uploads
