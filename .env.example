# ─────────────────────────────────────────────────────────────────────────────
# Kotu — образец конфигурации. Настоящий файл живёт на сервере в /opt/kotu/.env
# с правами 600 и НИКОГДА не попадает в git (см. .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

PORT=5010
DATABASE_URL=postgres://kotu:ПАРОЛЬ@localhost:5432/kotu

# Публичный адрес — от него зависит флаг secure у cookie сессии.
PUBLIC_BASE_URL=https://psy3107.ru

# ─── Модели: подписка Codex ──────────────────────────────────────────────────
# Все модели платформы работают по подписке Codex владелицы (ARCHITECTURE.md §5).
# Платформа не держит вход в подписку: запросы идут в локальный мост агента ПСИ
# (служба psy-platform-bridge, Unix-сокет), а он берет токен у Hermes.
# Пользователь kotu должен входить в группу psy-platform, иначе сокет закрыт.
CODEX_BRIDGE_SOCKET=/run/psy-platform-bridge.sock

# Какая модель делает какую работу. Поменять = правка строки и
# `systemctl restart kotu`, пересобирать приложение не нужно. Названия - из
# списка моделей Codex. Старые значения прежних поставщиков (claude-*,
# gemini-*, sonar-*) платформа заменит значением по умолчанию с записью в журнал.
MODEL_STRUCTURE=gpt-5.4                 # оформление расшифровок
MODEL_LECTURE=gpt-5.6-sol               # план, главы и список литературы лекции
MODEL_RESEARCH=gpt-5.6-sol              # веб-исследование для лекций (поиск Codex)
MODEL_DECK=gpt-5.6-sol                  # раскадровка и правка слайда
MODEL_SCENE=gpt-5.6-sol                 # сюжет метафоры для иллюстрации
MODEL_REVIEW=gpt-5.6-sol                # приемка иллюстрации (смотрит на картинку)
MODEL_IMAGE=gpt-image-2                 # иллюстрации; по подписке модель задает Codex

# Размер картинки. Брендбук требует 16:9. Codex рисует 3:2, мост обрезает по
# центру до этого размера. По ключу API размер передается как есть.
IMAGE_SIZE=1536x864
IMAGE_QUALITY=medium

# ─── Запасной путь: ключ OpenAI API ──────────────────────────────────────────
# Когда подписка недоступна (лимит, вход отозван, мост молчит), платформа
# переходит на ключ API - только после того, как уведомление владелице ушло в
# Telegram. MODEL_ON_LIMIT=wait - не переходить на ключ, а ждать подписку.
# Без ключа задачи ждут сброса лимита, попытки при этом не тратятся.
# Ключ вводится вслепую скриптом ./set-ai-key.sh.
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
AI_INTEGRATIONS_OPENAI_API_KEY=sk-...
MODEL_ON_LIMIT=api

# ─── Сообщения владелице в Telegram (через мост ПСИ) ─────────────────────────
NOTIFY_TZ=Europe/Moscow                 # время в сообщениях
NOTIFY_DONE=on                          # готовые и проваленные задачи; off - выключить

# ─── Агент ПСИ: инструменты платформы (MCP) ──────────────────────────────────
# Слушает только 127.0.0.1, nginx его не проксирует. Здесь - SHA-256 токена,
# сам токен - в .env профиля агента (KOTU_MCP_TOKEN). Без этих строк MCP
# не запускается, сайт работает как обычно.
AGENT_MCP_PORT=5011
AGENT_MCP_TOKEN_SHA256=
AGENT_MCP_USER_ID=

# ─── Распознавание речи (локальный Whisper) ──────────────────────────────────
# Аудио не покидает сервер. Адрес - внутренний маршрутизатор nginx, который
# отправляет /v1/audio/* в локальный Whisper.
WHISPER_BASE_URL=http://127.0.0.1:8444/v1
MODEL_TRANSCRIBE=gpt-4o-transcribe       # имя модели в запросе; распознает локальный Whisper

# Локальный распознаватель персональных данных (natasha).
NER_URL=http://127.0.0.1:9020/ner

# Локальные эмбеддинги (kotu-embed, multilingual-e5-large, 1024 измерения).
# Индексация библиотеки не покидает сервер.
EMBED_URL=http://127.0.0.1:9030/embed

# Куда складывать загруженное аудио (должно переживать перезапуск).
UPLOAD_DIR=/opt/kotu/uploads

# Архив файлов: прежние версии и удалённое, только пополняется. Должен быть
# на том же диске, что и каталоги данных, — тогда архив держит файлы жёсткими
# ссылками и места почти не занимает.
ARCHIVE_DIR=/opt/kotu/archive

# ─── Почта (письма о сбросе пароля) ──────────────────────────────────────
# Yandex Cloud Postbox по HTTPS (lib/postbox.ts): сервер стоит в DigitalOcean,
# где исходящие почтовые порты закрыты, и SMTP оттуда не работает. Домен
# отправителя example.ru подтверждён в Postbox записями DKIM. Ключ - статический
# ключ доступа сервисного аккаунта с ролью postbox.sender, вводится вслепую
# скриптом ./set-mail-postbox.sh (он же шлёт пробное письмо симулятору Postbox).
POSTBOX_KEY_ID=...
POSTBOX_SECRET_KEY=...
MAIL_FROM=noreply@example.ru

# Запасной путь - SMTP Яндекс 360 (домен example.ru, SPF и DKIM настроены).
# Включается, только если ключа Postbox нет, и работает только там, где
# почтовые порты открыты. SMTP_PASS - это ПАРОЛЬ ПРИЛОЖЕНИЯ (id.yandex.ru →
# Безопасность → Пароли приложений → Почта), вводится вслепую скриптом
# ./set-mail.sh.
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=noreply@example.ru
SMTP_PASS=...
