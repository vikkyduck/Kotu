# Рабочая среда Кота — основной адрес платформы.
# Статика фронта + /api на Express (127.0.0.1:5010).
# Порт 80 обслуживает общий сайт acme (ops/ПЕРЕЕЗД-AMS3.md, шаг 3).
server {
    server_name psy3107.ru www.psy3107.ru;

    # аудиозаписи до 1 ГБ
    client_max_body_size 1024m;

    root /opt/kotu/public;
    index index.html;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/json application/javascript text/javascript image/svg+xml;

    # Заголовки безопасности страниц (location /, = /index.html, /assets/).
    # Страница исполняет только свои скрипты из файлов: встроенные и чужие
    # браузер не запустит, даже если чужой HTML как-то окажется на странице.
    # Сайт нельзя встроить в чужую страницу, браузер не угадывает тип файлов,
    # только HTTPS. nginx не наследует add_header в location со своими
    # add_header, поэтому набор повторён в каждом location - меняйте все три.
    # На /api/ политики страниц нет: файлы библиотеки открываются во вкладке
    # (PDF), а Content-Security-Policy на ответе ломает просмотрщик PDF в
    # Chrome. Файлы API защищает сам сервер (routes/documents/file-headers.ts).

    location /api/ {
        proxy_pass http://127.0.0.1:5010;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # долгая загрузка и транскрибация
        proxy_read_timeout 1800s;
        proxy_send_timeout 300s;
        proxy_request_buffering off;
        add_header Referrer-Policy "same-origin" always;
        add_header Strict-Transport-Security "max-age=15552000" always;
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; media-src 'self' blob:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "same-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
        add_header Strict-Transport-Security "max-age=15552000" always;
    }

    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; media-src 'self' blob:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "same-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
        add_header Strict-Transport-Security "max-age=15552000" always;
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; media-src 'self' blob:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "same-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
        add_header Strict-Transport-Security "max-age=15552000" always;
    }

    listen [::]:443 ssl;
    listen 443 ssl;
    ssl_certificate /etc/letsencrypt/live/psy3107.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/psy3107.ru/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}
